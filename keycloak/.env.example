# Copy to .env on the VM and fill in real values. Never commit the real file.

# Public hostname for Keycloak; point its DNS A record at the VM's public IP.
KC_HOSTNAME="auth.dourak.app"

# MySQL HeatWave DB system. Use its private IP from the Oracle console.
# Avoid "$" in the password: Docker Compose treats it as a variable reference.
KC_DB_URL="jdbc:mysql://10.0.1.x:3306/keycloak?sslMode=REQUIRED"
KC_DB_USERNAME="keycloak"
KC_DB_PASSWORD=""

KC_BOOTSTRAP_ADMIN_USERNAME="admin"
KC_BOOTSTRAP_ADMIN_PASSWORD=""

# Dourak client. Use the same secret as KEYCLOAK_CLIENT_SECRET in the app.
DOURAK_APP_URL="https://dourak.app"
KC_DOURAK_CLIENT_SECRET=""

# Google OAuth client used for "Sign in with Google".
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Resend SMTP, used for email verification and password resets.
KC_SMTP_PASSWORD=""
KC_SMTP_FROM="onboarding@dourak.app"
