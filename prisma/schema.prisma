// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id             String       @id @default(cuid())
  name           String?
  email          String?      @unique
  emailVerified  DateTime?
  image          String?
  // Email notification opt-outs (managed by the user in /settings).
  emailRecruitment Boolean    @default(true)
  emailSchedule    Boolean    @default(true)
  emailRoleAdded   Boolean    @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  accounts       Account[]
  sessions       Session[]
  schedules      Schedule[]
  assignments    Assignment[]
  availabilities Availability[]
  roles          UserRole[]
  adminSchedules ScheduleAdmin[]
}

model UserRole {
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId String
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)
  type   String @default("required") // "required" or "optional"

  @@id([userId, roleId])
}

model Account {
  id                 String  @id @default(cuid())
  userId             String
  type               String
  provider           String
  providerAccountId  String
  refresh_token      String? @db.Text
  access_token       String? @db.Text
  expires_at         Int?
  token_type         String?
  scope              String?
  id_token           String? @db.Text
  session_state      String?
  oauth_token_secret String?
  oauth_token        String?
  user               User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Role {
  id          String   @id @default(cuid())
  name        String
  description String?
  color       String?  @db.VarChar(12)
  inviteToken String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  shifts      Shift[]
  recurringShifts RecurringShift[]
  scheduleEventShifts ScheduleEventShift[]
  users       UserRole[]
  
  scheduleId  String?
  schedule    Schedule? @relation(fields: [scheduleId], references: [id], onDelete: Cascade)

  @@unique([scheduleId, name])
}

model Schedule {
  id               String          @id @default(cuid())
  name             String
  googleCalendarId String?
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plans            Plan[]
  roles            Role[]
  recurringShifts  RecurringShift[]
  scheduleEvents   ScheduleEvent[]
  admins           ScheduleAdmin[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model Plan {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  status    ScheduleStatus @default(DRAFT)
  
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  
  events     CalendarEvent[]
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ScheduleStatus {
  DRAFT
  RECRUITMENT
  SCHEDULED
  ARCHIVED
}

model CalendarEvent {
  id               String   @id @default(cuid())
  googleEventId    String?
  planId           String
  plan             Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  title            String
  start            DateTime
  end              DateTime
  recurringEventId String?
  shifts           Shift[]

  @@unique([planId, googleEventId])
}

model Shift {
  id              String        @id @default(cuid())
  calendarEventId String
  calendarEvent   CalendarEvent @relation(fields: [calendarEventId], references: [id], onDelete: Cascade)
  roleId          String?
  role            Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  name            String?       // Optional override for the role name
  needed          Int           @default(1)
  // Whether this role must be filled for this specific event (defaults from Role.type).
  required        Boolean       @default(true)
  assignments     Assignment[]
  availabilities  Availability[]
}

model Availability {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([shiftId, userId])
}

model Assignment {
  id        String   @id @default(cuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  name      String?  // For manual assignments or guests
  email     String?
  status    String   @default("PENDING") // PENDING, CONFIRMED, DECLINED
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shiftId, userId])
  @@unique([shiftId, email])
}

model ScheduleAdmin {
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@id([scheduleId, userId])
}

model RecurringShift {
  id               String   @id @default(cuid())
  scheduleId       String
  schedule         Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  recurringEventId String
  roleId           String?
  role             Role?    @relation(fields: [roleId], references: [id], onDelete: SetNull)
  name             String?
  needed           Int      @default(1)
  required         Boolean  @default(true)
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([scheduleId, recurringEventId, roleId])
}

// Schedule-level "calendar": reusable events defined once on a schedule.
// A plan materializes (copies) these into concrete CalendarEvents for its
// date range at creation time. Editing these later does not affect existing
// plans (plans are snapshots).
model ScheduleEvent {
  id         String   @id @default(cuid())
  scheduleId String
  schedule   Schedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  title      String

  // "ONE_OFF" or "RECURRING"
  type       String   @default("ONE_OFF")

  // For ONE_OFF: the single occurrence.
  // For RECURRING: the FIRST occurrence (its date anchors the series and its
  // start/end times define the wall-clock time + duration of every occurrence).
  start      DateTime?
  end        DateTime?

  // iCal RRULE string (RFC 5545) describing how a RECURRING event repeats,
  // e.g. "RRULE:FREQ=WEEKLY;BYDAY=SU,WE;INTERVAL=1". Null for one-off events.
  rrule      String?

  // Legacy simple-weekly fields (superseded by `rrule`); kept for back-compat.
  weekday    Int?
  startTime  String?
  endTime    String?

  shifts     ScheduleEventShift[]

  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model ScheduleEventShift {
  id              String        @id @default(cuid())
  scheduleEventId String
  scheduleEvent   ScheduleEvent @relation(fields: [scheduleEventId], references: [id], onDelete: Cascade)
  roleId          String?
  role            Role?         @relation(fields: [roleId], references: [id], onDelete: SetNull)
  name            String?
  needed          Int           @default(1)
  required        Boolean       @default(true)
}

